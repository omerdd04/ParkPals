# Copy this file to ".env" and fill in your Supabase project's PUBLIC keys.
# Find them in Supabase: Project Settings → API.
#
# These are the client-side (public) keys — safe to use in the frontend, since
# Row Level Security protects the data. Do NOT put the service_role key or the
# database password here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
